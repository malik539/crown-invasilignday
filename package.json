{
  "name": "crown-invisalign-day",
  "version": "1.0.0",
  "private": true,
  "description": "Invisalign Day landing page for Crown Dental Care (Rockville, MD). Static HTML + Tailwind CSS.",
  "scripts": {
    "build": "tailwindcss -i ./src/tailwind.css -o ./css/site.css --minify",
    "watch": "tailwindcss -i ./src/tailwind.css -o ./css/site.css --watch",
    "serve": "npx --yes serve -l 3000 ."
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
